<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block access to hidden files and directories (.env, .git, etc.)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # 2. Block direct web access to sensitive internal Laravel folders
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor) - [F,L]

    # 3. Block direct web access to root configuration and build files
    RewriteRule ^(\.env|\.env\..*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js) - [F,L]

    # 4. Pass Authorization header for API tokens (Sanctum / JWT)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 5. Transparently route all traffic to the /public directory without changing the URL
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
